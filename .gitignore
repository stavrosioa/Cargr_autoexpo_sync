# Virtual Environment
venv/
env/
.venv/

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Large local per-listing directories and images
data/
downloads/

# Large SQLite Database and JSON exports (> 100MB exceeds GitHub hard limit)
database/*.db
database/*.json
database/*.db-journal
database/*.db-wal
database/*.db-shm

# Explicitly track CSV export (contains all 17,730 listings, 43MB fits on GitHub)
!database/autoexpo_parts.csv
!database/.gitkeep

# OS & Editor files
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
